# EcoNexo Web rc.6 - Render Static Site
# Root Directory: apps/web
# Build Command: npm ci && npm run build:cloudflare:production
# Publish Directory: out

NEXT_PUBLIC_API_URL=https://econexo.onrender.com
NEXT_PUBLIC_WS_URL=wss://econexo.onrender.com
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_STATIC_EXPORT=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Open-Meteo no requiere una clave en esta integración.
NEXT_PUBLIC_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
NEXT_PUBLIC_OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
NEXT_PUBLIC_OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Fallback opcional. También se configura por organización en Admin Core.
NEXT_PUBLIC_COPERNICUS_WMS_URL=
NEXT_PUBLIC_APP_URL=https://econexo-web.onrender.com
