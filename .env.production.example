# EcoNexo Misiones - produccion generica.
# Para Render usar preferentemente .env.render.example.
ENVIRONMENT=production
RELEASE_VERSION=1.0.0-rc.6.2-render

DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/econexo
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=30
# false si el plan pago usa Pre-Deploy; true en un servicio gratuito.
RUN_MIGRATIONS_ON_START=false

JWT_SECRET=REEMPLAZAR_64_CARACTERES_ALEATORIOS
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_OTROS_64_CARACTERES
FORWARDED_ALLOW_IPS=REEMPLAZAR_CIDR_PROXY

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
PLATFORM_ADMIN_EMAILS=econexoargentina@gmail.com
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CONTRASENA_TEMPORAL_SEGURA
PLATFORM_ADMIN_FORCE_PASSWORD_CHANGE=true
PLATFORM_ADMIN_RESET_INITIAL_PASSWORD=true
PLATFORM_ADMIN_NAME=Administrador General EcoNexo
PLATFORM_ADMIN_ORGANIZATION=EcoNexo Plataforma
SALES_EMAIL=econexoargentina@gmail.com

MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
ANOMALY_ENABLED=false
ANOMALY_SERVICE_URL=

S3_ENABLED=false
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=econexo-reports-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_REPORT_PHOTO_BYTES=8388608

MAP_PROVIDER=leaflet
MAPBOX_TOKEN=
NEXT_PUBLIC_COPERNICUS_WMS_URL=
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
NASA_FIRMS_KEY=
FIRMS_INLINE_ENABLED=true
FIRMS_SOURCE=VIIRS_SNPP_NRT
PIPELINE_MAX_DEVICES_PER_RUN=100
PIPELINE_HTTP_TIMEOUT_SECONDS=20
FIRMS_POLL_SECONDS=900
ALLOW_DEMO_SATELLITE_FIXTURES=false

NEXT_PUBLIC_API_URL=https://api.econexo.com.ar
NEXT_PUBLIC_WS_URL=wss://api.econexo.com.ar
PUBLIC_APP_URL=https://app.econexo.com.ar
CORS_ORIGINS=https://app.econexo.com.ar

NEXT_PUBLIC_LEGAL_ENTITY_NAME=REEMPLAZAR_RAZON_SOCIAL
NEXT_PUBLIC_LEGAL_CUIT=REEMPLAZAR_CUIT
NEXT_PUBLIC_LEGAL_ADDRESS=REEMPLAZAR_DOMICILIO_MISIONES
NEXT_PUBLIC_LEGAL_JURISDICTION=Provincia de Misiones
NEXT_PUBLIC_LEGAL_EMAIL=privacidad@econexo.com.ar
LEGAL_EMAIL=privacidad@econexo.com.ar

PROVINCE=Misiones
EMERGENCY_NUMBER=911
SIM_NODE_COUNT=0

# Copernicus predeterminado: crear un OAuth Client en el Sentinel Hub Dashboard.
# Las credenciales son privadas del backend; no usar prefijo NEXT_PUBLIC_.
COPERNICUS_ENABLED_BY_DEFAULT=true
COPERNICUS_MODE=process_api
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
COPERNICUS_INSTANCE_ID=
COPERNICUS_WMS_URL=
COPERNICUS_HTTP_TIMEOUT_SECONDS=45
COPERNICUS_TIME_RANGE_DAYS=90
COPERNICUS_MAX_CLOUD_COVERAGE=80
COPERNICUS_MAX_DIMENSION=1024
COPERNICUS_CACHE_SECONDS=600
