# EcoNexo Misiones - plantilla de produccion. Copiar a .env y completar.
ENVIRONMENT=production

POSTGRES_DB=econexo
POSTGRES_USER=econexo_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRET_LARGO
POSTGRES_HOST=postgres-produccion
POSTGRES_PORT=5432

JWT_SECRET=REEMPLAZAR_64_CARACTERES_ALEATORIOS
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_OTROS_64_CARACTERES
FORWARDED_ALLOW_IPS=REEMPLAZAR_CIDR_PROXY

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Administración comercial de EcoNexo. Emails separados por coma.
# Estos usuarios ven solicitudes de licencia y mensajes globales de acceso.
PLATFORM_ADMIN_EMAILS=
SALES_EMAIL=

MINIO_ROOT_USER=REEMPLAZAR
MINIO_ROOT_PASSWORD=REEMPLAZAR
S3_BUCKET=econexo-reports-prod
S3_PUBLIC_ENDPOINT=https://files.econexo.com.ar
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_REPORT_PHOTO_BYTES=8388608

MAP_PROVIDER=leaflet
MAPBOX_TOKEN=
NEXT_PUBLIC_COPERNICUS_WMS_URL=

NASA_FIRMS_KEY=REEMPLAZAR_MAP_KEY
FIRMS_POLL_SECONDS=900
ALLOW_DEMO_SATELLITE_FIXTURES=false

NEXT_PUBLIC_API_URL=https://api.econexo.com.ar
NEXT_PUBLIC_WS_URL=wss://api.econexo.com.ar
PUBLIC_APP_URL=https://app.econexo.com.ar
CORS_ORIGINS=https://app.econexo.com.ar

NEXT_PUBLIC_LEGAL_ENTITY_NAME=REEMPLAZAR_RAZON_SOCIAL
NEXT_PUBLIC_LEGAL_CUIT=REEMPLAZAR_CUIT
NEXT_PUBLIC_LEGAL_ADDRESS=REEMPLAZAR_DOMICILIO_MISIONES
NEXT_PUBLIC_LEGAL_JURISDICTION=Provincia de Misiones
NEXT_PUBLIC_LEGAL_EMAIL=privacidad@econexo.com.ar
LEGAL_EMAIL=privacidad@econexo.com.ar

PROVINCE=Misiones
EMERGENCY_NUMBER=911
SIM_NODE_COUNT=0
