ENVIRONMENT=development
RELEASE_VERSION=1.0.0-rc.4-render
PORT=8000

DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=econexo
POSTGRES_USER=econexo
POSTGRES_PASSWORD=econexo_dev_pw
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=30
RUN_MIGRATIONS_ON_START=false

JWT_SECRET=change_me_dev_secret
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token
FORWARDED_ALLOW_IPS=127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
PLATFORM_ADMIN_EMAILS=admin@example.com
SALES_EMAIL=comercial@example.com

MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883

ANOMALY_ENABLED=true
