/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://unpkg.com; frame-src https://accounts.google.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss: http://localhost:8000 ws://localhost:8000; font-src 'self' data:

/informe*
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/dashboard*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
