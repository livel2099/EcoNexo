# EcoNexo API - Render (pegar en Environment > Add from .env)
# No subir un archivo con secretos reales al repositorio.

ENVIRONMENT=production
RELEASE_VERSION=1.0.0-rc.5-render
PORT=10000

# Copiar la Internal Database URL de Render Postgres.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-INTERNO:5432/econexo
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=30
RUN_MIGRATIONS_ON_START=true

# Generar dos valores diferentes con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_CON_OTROS_64_CARACTERES_HEXADECIMALES
NASA_FIRMS_KEY=REEMPLAZAR_CON_MAP_KEY_DE_NASA_FIRMS
FORWARDED_ALLOW_IPS=*

# Frontend Render actual. Sin barra final.
PUBLIC_APP_URL=https://econexo-web.onrender.com
CORS_ORIGINS=https://econexo-web.onrender.com

# Cuenta oculta de administración general. La contraseña solo se usa al crear
# la cuenta o tomar una cuenta previa sin password_changed_at.
PLATFORM_ADMIN_EMAILS=econexoargentina@gmail.com
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CONTRASENA_TEMPORAL_SEGURA
PLATFORM_ADMIN_FORCE_PASSWORD_CHANGE=true
PLATFORM_ADMIN_RESET_INITIAL_PASSWORD=true
PLATFORM_ADMIN_NAME=Administrador General EcoNexo
PLATFORM_ADMIN_ORGANIZATION=EcoNexo Plataforma
SALES_EMAIL=econexoargentina@gmail.com

# Google es opcional. Dejar vacio hasta configurar OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# La IA de sensores y S3 siguen opcionales; NASA FIRMS se procesa en econexo-satellite.
MQTT_ENABLED=false
ANOMALY_ENABLED=false
S3_ENABLED=false

# Al habilitar almacenamiento S3/R2, cambiar S3_ENABLED=true y completar:
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=econexo-reports-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_REPORT_PHOTO_BYTES=8388608
