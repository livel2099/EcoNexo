# EcoNexo API rc.6.2 - Render Web Service
# Root Directory: apps/api | Dockerfile: Dockerfile | Health: /health
# Pegar en Render > EcoNexo API > Environment. No guardar secretos reales en Git.

ENVIRONMENT=production
RELEASE_VERSION=1.0.0-rc.6.2-render
PORT=10000

# Usar la Internal Database URL de Render Postgres.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-INTERNO:5432/econexo
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=30
RUN_MIGRATIONS_ON_START=true

# Generar dos valores distintos: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_CON_OTROS_64_CARACTERES_HEXADECIMALES
FORWARDED_ALLOW_IPS=*

# URL real del Static Site. Sin barra final.
PUBLIC_APP_URL=https://econexo-web.onrender.com
CORS_ORIGINS=https://econexo-web.onrender.com
ECONEXO_WEB_ORIGIN=https://econexo-web.onrender.com

# Administrador general oculto. Habilitar solo para el primer alta/restablecimiento.
PLATFORM_ADMIN_EMAILS=econexoargentina@gmail.com
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_INITIAL_PASSWORD=
PLATFORM_ADMIN_FORCE_PASSWORD_CHANGE=true
PLATFORM_ADMIN_RESET_INITIAL_PASSWORD=false
PLATFORM_ADMIN_NAME=Administrador General EcoNexo
PLATFORM_ADMIN_ORGANIZATION=EcoNexo Plataforma
SALES_EMAIL=econexoargentina@gmail.com

# Google es opcional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# El core y el pipeline funcionan sin estos servicios externos.
MQTT_ENABLED=false
ANOMALY_ENABLED=false
S3_ENABLED=false


# Copernicus predeterminado: crear un OAuth Client en el Sentinel Hub Dashboard.
# Las credenciales son privadas del backend; no usar prefijo NEXT_PUBLIC_.
COPERNICUS_ENABLED_BY_DEFAULT=true
COPERNICUS_MODE=process_api
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
COPERNICUS_INSTANCE_ID=
COPERNICUS_WMS_URL=
COPERNICUS_HTTP_TIMEOUT_SECONDS=45
COPERNICUS_TIME_RANGE_DAYS=90
COPERNICUS_MAX_CLOUD_COVERAGE=80
COPERNICUS_MAX_DIMENSION=1024
COPERNICUS_CACHE_SECONDS=600

# Pipeline integrado: nodos virtuales Open-Meteo, reglas y FIRMS.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
NASA_FIRMS_KEY=
FIRMS_INLINE_ENABLED=true
FIRMS_SOURCE=VIIRS_SNPP_NRT
PIPELINE_MAX_DEVICES_PER_RUN=100
PIPELINE_HTTP_TIMEOUT_SECONDS=20

# Completar solo al habilitar Cloudflare R2/AWS S3.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=econexo-reports-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_REPORT_PHOTO_BYTES=8388608
