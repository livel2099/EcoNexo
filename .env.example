# ===========================================================================
# EcoNexo — variables de entorno raiz (compartidas por docker-compose).
# Copiar a .env y ajustar. NUNCA commitear .env (esta en .gitignore).
# ===========================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=econexo
POSTGRES_USER=econexo
POSTGRES_PASSWORD=econexo_dev_pw

# --- Auth (FastAPI) ---
# Generar uno real: `openssl rand -hex 32`
JWT_SECRET=change_me_dev_secret

# --- Almacenamiento S3-compatible (MinIO local / S3 en prod) ---
MINIO_ROOT_USER=econexo
MINIO_ROOT_PASSWORD=econexo_dev_pw
S3_BUCKET=econexo-reports
# Endpoint publico para construir URLs de fotos accesibles desde el navegador
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Mapas (front) ---
# leaflet (default, sin token) | mapbox (requiere MAPBOX_TOKEN)
MAP_PROVIDER=leaflet
MAPBOX_TOKEN=

# --- NASA FIRMS (focos de calor). Key gratuita por email:
#     https://firms.modaps.eosdis.nasa.gov/api/  -> MAP_KEY
# Si queda vacio, satellite-service usa el fixture grabado.
NASA_FIRMS_KEY=
FIRMS_POLL_SECONDS=900

# --- Front URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Simulador (nodos ESP32 emulados). 0 = usar solo datos semilla.
SIM_NODE_COUNT=0
