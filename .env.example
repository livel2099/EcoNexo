# EcoNexo - desarrollo local. Copiar a .env; nunca commitear secretos.
ENVIRONMENT=development
RELEASE_VERSION=1.0.0-rc.5-render

DATABASE_URL=
POSTGRES_DB=econexo
POSTGRES_USER=econexo
POSTGRES_PASSWORD=econexo_dev_pw
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=30
RUN_MIGRATIONS_ON_START=false

JWT_SECRET=change_me_dev_secret
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token
FORWARDED_ALLOW_IPS=127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
PLATFORM_ADMIN_EMAILS=econexoargentina@gmail.com
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_INITIAL_PASSWORD=
PLATFORM_ADMIN_FORCE_PASSWORD_CHANGE=true
PLATFORM_ADMIN_RESET_INITIAL_PASSWORD=false
PLATFORM_ADMIN_NAME=Administrador General EcoNexo
PLATFORM_ADMIN_ORGANIZATION=EcoNexo Plataforma
SALES_EMAIL=comercial@example.com

MQTT_ENABLED=true
ANOMALY_ENABLED=true
S3_ENABLED=true
MINIO_ROOT_USER=econexo
MINIO_ROOT_PASSWORD=econexo_dev_pw
S3_REGION=us-east-1
S3_BUCKET=econexo-reports
S3_PUBLIC_ENDPOINT=http://localhost:9000
MAX_REPORT_PHOTO_BYTES=8388608
S3_SERVER_SIDE_ENCRYPTION=

MAP_PROVIDER=leaflet
MAPBOX_TOKEN=
NASA_FIRMS_KEY=
FIRMS_POLL_SECONDS=900
ALLOW_DEMO_SATELLITE_FIXTURES=true

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEGAL_EMAIL=
SIM_NODE_COUNT=0

PROVINCE=Misiones
EMERGENCY_NUMBER=911
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_CUIT=
NEXT_PUBLIC_LEGAL_ADDRESS=Misiones, Argentina
NEXT_PUBLIC_LEGAL_JURISDICTION=Provincia de Misiones
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_COPERNICUS_WMS_URL=
