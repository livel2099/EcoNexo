# EcoNexo — variables raiz. Copiar a .env; nunca commitear secretos.
ENVIRONMENT=development

POSTGRES_DB=econexo
POSTGRES_USER=econexo
POSTGRES_PASSWORD=econexo_dev_pw

# Generar para produccion: openssl rand -hex 32
JWT_SECRET=change_me_dev_secret
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token
FORWARDED_ALLOW_IPS=127.0.0.1

# Google Cloud Console > OAuth 2.0 Client IDs > Web application.
# Registrar http://localhost:3000 y el dominio productivo como JavaScript origins.
GOOGLE_CLIENT_ID=
# Opcional: IDs OAuth de Android/iOS separados por coma.
GOOGLE_CLIENT_IDS=

# Administración comercial de EcoNexo. Emails separados por coma.
# Estos usuarios ven solicitudes de licencia y mensajes globales de acceso.
PLATFORM_ADMIN_EMAILS=econexoargentina@gmail.com
SALES_EMAIL=econexoargentina@gmail.com

MINIO_ROOT_USER=econexo
MINIO_ROOT_PASSWORD=econexo_dev_pw
S3_BUCKET=econexo-reports
S3_PUBLIC_ENDPOINT=http://localhost:9000
MAX_REPORT_PHOTO_BYTES=8388608
# Produccion S3: AES256. MinIO local queda vacio salvo KMS configurado.
S3_SERVER_SIDE_ENCRYPTION=

MAP_PROVIDER=leaflet
MAPBOX_TOKEN=

NASA_FIRMS_KEY=
FIRMS_POLL_SECONDS=900

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEGAL_EMAIL=

SIM_NODE_COUNT=0

# Alcance territorial oficial
PROVINCE=Misiones
EMERGENCY_NUMBER=911

# Identidad legal pública del frontend
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_CUIT=
NEXT_PUBLIC_LEGAL_ADDRESS=Misiones, Argentina
NEXT_PUBLIC_LEGAL_JURISDICTION=Provincia de Misiones
NEXT_PUBLIC_LEGAL_EMAIL=

# Copernicus WMS propio. No usar UUIDs de terceros.
NEXT_PUBLIC_COPERNICUS_WMS_URL=

# Fixtures satelitales: true solo en desarrollo/demo. En producción debe ser false.
ALLOW_DEMO_SATELLITE_FIXTURES=true
